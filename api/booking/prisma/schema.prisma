generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        Int      @id @default(autoincrement())
  userId    Int
  beachId   Int
  visitDate DateTime
  status    BookingStatus @default(PENDING)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
